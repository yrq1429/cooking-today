    "id": "htc-e85e6c3a",
    "name": "清蒸鲈鱼",
    "category": "荤菜",
    "cuisine": "家常",
    "desc": "清蒸锁住鲜味，葱油提香",
    "cover": "/assets/recipes/htc-e85e6c3a-2.jpg",
    "ingredients": [
      {
        "name": "鲈鱼",
        "amount": "1条"
      },
      {
        "name": "香葱",
        "amount": "3根"
      },
      {
        "name": "姜",
        "amount": "1块"
      },
      {
        "name": "食用油",
        "amount": "10～15ml"
      },
      {
        "name": "蒸鱼豉油",
        "amount": "10～15ml"
      },
      {
        "name": "盐",
        "amount": "适量，腌制后冲净"
      }
