  {
    "id": "htc-38a2f433",
    "name": "西红柿鸡蛋挂面",
    "category": "主食",
    "cuisine": "家常",
    "desc": "一碗热面，照顾好自己的胃",
    "cover": "/assets/recipes/htc-38a2f433-3.jpg",
    "ingredients": [
