  {
    "id": "htc-9c3e615c",
    "name": "手撕包菜",
    "category": "荤菜",
    "cuisine": "家常",
    "desc": "大火快炒，留住清脆的口感",
    "cover": "/assets/recipes/htc-9c3e615c-3.jpg",
    "ingredients": [
      {
        "name": "包菜",
        "amount": "1 颗"
      },
      {
        "name": "五花肉",
        "amount": "200 g"
      },
      {
        "name": "小米辣",
        "amount": "2 根"
      },
      {
        "name": "食用油",
        "amount": "60 ml"
      },
      {
        "name": "料酒",
        "amount": "5 ml"
      },
      {
        "name": "生抽",
        "amount": "5 ml"
      },
      {
        "name": "香醋",
        "amount": "5 ml"
      },
      {
        "name": "鸡精",
        "amount": "2 g"
      },
      {
        "name": "姜",
        "amount": "2 片"
      },
      {
        "name": "蒜头",
        "amount": "2 粒"
      },
      {
        "name": "蒜苗",
        "amount": "0.5 根"
      },
      {
        "name": "盐",
        "amount": "5 g"
      }
    ],
    "ingredientNote": "这份做法含五花肉；想做素版可不放。",
    "steps": [
      "包菜对半切开，去掉中间白色部分【参见图一】",
      "手撕包菜，碗中放入 2 g 盐，清洗包菜并沥干备用【参见图二】",
      "姜片、蒜头、小米辣、蒜苗处理后备用【参见图三】",
      "五花肉切片，清水清洗后备用",
      "锅中加入 30 ml 食用油，倒入包菜翻炒，大火翻炒 1 分钟 后，加入 3 g 盐 ，继续翻炒 2 分钟 后取出备用",
      "锅中加入 30 ml 食用油，倒入五花肉，大火翻炒 1 分钟",
      "倒入姜片等材料，翻炒 1 分钟",
      "倒入包菜翻炒后，加入 香醋、料酒、鸡精、料酒，大火继续翻炒，2 分钟 后出锅"
    ],
    "stepImages": {
      "0": "/assets/recipes/htc-9c3e615c-0.jpg",
      "1": "/assets/recipes/htc-9c3e615c-1.jpg",
      "2": "/assets/recipes/htc-9c3e615c-2.jpg"
    },
    "gallery": [
      "/assets/recipes/htc-9c3e615c-0.jpg",
      "/assets/recipes/htc-9c3e615c-1.jpg",
      "/assets/recipes/htc-9c3e615c-2.jpg",
      "/assets/recipes/htc-9c3e615c-3.jpg"
    ],
    "tips": [
      "步骤五中，翻炒时间需要实际情况做调整，一般是炒到包菜七分熟后即可。七分熟是指包菜已经出水质感变软",
      "步骤五中，加盐的作用是锁住包菜水分的同时，给包菜上一点味道",
      "最后一个步骤中，翻炒时间根据实际情况和个人口感做灵活调整"
    ],
    "taste_tags": [
