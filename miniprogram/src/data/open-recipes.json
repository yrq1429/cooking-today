[
  {
    "id": "htc-13e6ae30",
    "name": "香菇滑鸡",
    "category": "荤菜",
    "cuisine": "家常",
    "desc": "鲜嫩滑口，留一勺汤汁拌饭",
    "cover": "/assets/recipes/htc-13e6ae30-0.jpg",
    "ingredients": [
      {
        "name": "鸡腿",
        "amount": "2个"
      },
      {
        "name": "干香菇",
        "amount": "5朵"
      },
      {
        "name": "姜",
        "amount": "2片"
      },
      {
        "name": "葱",
        "amount": "2根"
      },
      {
        "name": "蒜",
        "amount": "2瓣"
      },
      {
        "name": "温水",
        "amount": "150ml，用于泡香菇"
      },
      {
        "name": "料酒",
        "amount": "15ml"
      },
      {
        "name": "生抽",
        "amount": "45ml：腌肉15ml，烹调30ml"
      },
      {
        "name": "盐",
        "amount": "约1.5g，按口味调整"
      },
      {
        "name": "老抽",
        "amount": "15ml"
      },
      {
        "name": "白糖",
        "amount": "约1汤匙，按口味减少"
      },
      {
        "name": "香油",
        "amount": "5ml"
      },
      {
        "name": "食用油",
        "amount": "适量"
      }
    ],
    "ingredientNote": "含干香菇泡发时间，按两人份准备。",
    "steps": [
      "温水泡发干香菇",
      "姜切小块，葱切段，蒜对半切小粒",
      "鸡腿去骨（不去骨也可，只是略影响程序员吃饭的效率而已），切成小块",
      "泡发的香菇一分为四，香菇水留着备用",
      "鸡腿肉焯水 1 分钟，去除血沫和杂质",
      "鸡腿肉中加料酒 15ml、生抽 15ml、盐 1.5g、老抽 15ml，抓匀",
      "油温 3 成，下入鸡腿肉煸炒，等鸡腿肉金黄后盛出备用",
      "锅留底油，下入葱、姜、蒜炒香，香菇入锅，大火翻匀",
      "等待 20 秒会有香菇香味从锅中飘出，此时下入煸炒过的鸡腿肉，下入香菇水（全部，本程序员认为的灵魂操作）、糖 15ml、生抽 30ml",
      "转中火不盖盖，咕嘟 2 分钟收浓汤汁，淋入香油 5ml，撒上葱花后即可关火、装盘"
    ],
    "stepImages": {},
    "gallery": [
      "/assets/recipes/htc-13e6ae30-0.jpg"
    ],
    "tips": [
      "干香菇充分泡发后洗净；香菇水静置，取上层清液。",
      "鸡腿肉切小块，炒至完全熟透再出锅；较大的肉块需延长焖煮。"
    ],
    "taste_tags": [
      "咸鲜"
    ],
    "scene_tags": [
      "下饭菜"
    ],
    "difficulty": 3,
    "time_minutes": 60,
    "servings": 2,
    "nutrition": {
      "calories": 0,
      "note": ""
    },
    "source": {
