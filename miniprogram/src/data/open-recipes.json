  {
    "id": "htc-bf658184",
    "name": "湖南家常红烧肉",
    "category": "荤菜",
    "cuisine": "家常",
    "desc": "慢炖收汁，软糯浓香",
    "cover": "/assets/recipes/htc-bf658184-0.jpg",
    "ingredients": [
      {
        "name": "五花肉",
        "amount": "500g"
      },
      {
