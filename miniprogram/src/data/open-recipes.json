  {
    "id": "htc-870d9d11",
    "name": "玉米排骨汤",
    "category": "汤",
    "cuisine": "家常",
    "desc": "一锅清甜，慢慢炖出家的味道",
    "cover": "/assets/recipes/htc-870d9d11-0.jpg",
    "ingredients": [
      {
        "name": "排骨",
        "amount": "500～800g"
      },
      {
        "name": "玉米",
        "amount": "1根"
      },
      {
        "name": "胡萝卜",
        "amount": "1根"
      },
      {
        "name": "姜",
        "amount": "适量，分焯水和煸炒使用"
      },
      {
        "name": "大葱",
        "amount": "小半根"
      },
      {
        "name": "小葱",
        "amount": "1根"
      },
      {
        "name": "食用油",
        "amount": "10ml"
      },
      {
        "name": "黑胡椒粉",
        "amount": "约4g，可减量"
      },
      {
        "name": "料酒",
        "amount": "10ml"
      },
      {
        "name": "醋",
        "amount": "10ml"
      },
      {
        "name": "盐",
        "amount": "适量，按汤量调整"
      },
      {
        "name": "开水",
        "amount": "约1000ml，没过食材"
      }
    ],
    "ingredientNote": "约三人份；盐在出锅前少量多次加入。",
    "steps": [
      "大葱切成 3-4cm 的大段，用刀背拍一下",
      "玉米剁成小块",
      "胡箩卜切成滚刀块",
      "生姜去皮切大片",
      "新鲜的排骨砍成小块",
      "排骨凉水下锅，放入大葱、生姜、料酒开始焯水，大火烧开，撇去浮沫，捞出排骨，沥干水分",
      "热锅凉油，切大片的生姜和排骨一起下锅煸炒，待排骨表面微微焦黄，放入醋（可加速肉质软烂），继续煸炒一分钟",
      "冲入开水，一次给足，之后就不要再加了，大火烧开",
      "先下入玉米，放入胡椒粉，盖盖小火炖二十分钟，然后放入胡萝卜，盖盖继续小火炖四十分钟",
      "调味很简单，出锅前三分钟，除了盐什么都不用放，最后撒上一把小葱花即可"
    ],
